[Unit]
Description=AgentWorld Phase 2 private world host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clanker
Group=clanker
WorkingDirectory=/opt/agentworld-viewer
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=AgentWorld__Runtime__AdvanceScript=true
Environment=AgentWorld__Http__Port=5188
Environment=AgentWorld__Pairing__LocalApprovalPort=5189
Environment=AgentWorld__Pairing__StatePath=/var/lib/agentworld-viewer/owner-authority.json
Environment=AgentWorld__Runtime__StatePath=/var/lib/agentworld-viewer/phase-two-runtime.json
Environment=AgentWorld__Assets__CatalogPath=/etc/agentworld-viewer/approved-assets.json
Environment=DOTNET_NOLOGO=1
StateDirectory=agentworld-viewer
ExecStart=/home/clanker/.local/bin/dotnet /opt/agentworld-viewer/AgentWorld.Viewer.dll
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
