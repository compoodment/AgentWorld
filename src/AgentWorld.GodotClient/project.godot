; Engine configuration file.
; The Phase 2 Godot client renders signed owner projections and submits paired
; owner requests. It never owns or directly mutates simulation state.
config_version=5

[application]
config/name="AgentWorld"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[agentworld]
world_url="http://127.0.0.1:5188"

[dotnet]
project/assembly_name="AgentWorld.GodotClient"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
